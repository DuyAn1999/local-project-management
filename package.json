{
  "name": "local-project-management",
  "productName": "Local Projects",
  "version": "0.1.0",
  "description": "Discover and run local coding projects from a desktop app.",
  "private": true,
  "license": "UNLICENSED",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "test:smoke:packaged": "playwright test --project=packaged",
    "test:smoke:development": "playwright test --project=development",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
